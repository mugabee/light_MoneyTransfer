# Server
PORT=3000

# Postgres connection string (Neon, Supabase, or any Postgres host)
DATABASE_URL=

# WhatsApp Cloud API (Meta) — from your Meta Business dashboard
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=choose-a-random-string

# Rate engine
RATE_FIAT=RWF
# Starting margin only — once the app has run once, the admin can change this
# live from the dashboard's Rate Settings panel, which takes over from here.
RATE_MARGIN_PERCENT=2
RATE_MIN_VOLUME_USDT=700

# Admin login for /dashboard.html
# Generate ADMIN_PASSWORD_HASH with: node scripts/hash-password.js "your-chosen-password"
# JWT_SECRET can be any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
JWT_SECRET=
